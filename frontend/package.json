{
  "name": "hepatoplan-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:browser:app": "npm run build -- --base=/demo/ && playwright test --config playwright.app.config.ts",
    "build:fixture": "vite build --config browser-tests/vite.config.ts --mode fixture-build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.183.1",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
