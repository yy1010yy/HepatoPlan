{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm --prefix frontend run build -- --base=/",
  "outputDirectory": "frontend/dist/app",
  "functions": {
    "api/*/explain.ts": {
      "includeFiles": "public/cases/**/*.json",
      "maxDuration": 30
    }
  }
}
