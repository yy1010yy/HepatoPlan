{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm --prefix frontend run build -- --base=/",
  "outputDirectory": "frontend/dist/app",
  "functions": {
    "api/*/explain.ts": {
      "includeFiles": "{public/cases/**/*.json,api/{_configured-app,app,gemini}.mts,backend/plan-analysis.mts,frontend/src/{plan-context.ts,planning/*.ts}}",
      "maxDuration": 30
    }
  }
}
