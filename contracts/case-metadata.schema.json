{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HepatoPlan case metadata v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "caseId",
    "dimensions",
    "voxelSpacingMm",
    "voxelToWorldMm",
    "labelCounts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?![\\s\\S])"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?![\\s\\S])"
    },
    "dimensions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "voxelSpacingMm": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "voxelToWorldMm": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": [
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        {
          "const": [
            0,
            0,
            0,
            1
          ]
        }
      ]
    },
    "labelCounts": {
      "type": "object",
      "required": [
        "parenchyma",
        "tumour"
      ],
      "additionalProperties": false,
      "properties": {
        "parenchyma": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tumour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
